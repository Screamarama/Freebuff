{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug hello-rust",
      "program": "${workspaceFolder}/target/debug/hello-rust.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopOnEntry": false,
      "sourceLanguages": ["rust"]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug hello-rust (rebuild first)",
      "cargo": {
        "args": ["build", "--bin=hello-rust", "--package=hello-rust"],
        "filter": {
          "name": "hello-rust",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopOnEntry": false
    }
  ]
}
