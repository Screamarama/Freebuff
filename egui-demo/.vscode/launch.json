{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug egui-demo",
      "cargo": {
        "args": ["build", "--bin=egui-demo", "--package=egui-demo"],
        "filter": {
          "name": "egui-demo",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopOnEntry": false
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug egui-demo (prebuilt binary)",
      "program": "${workspaceFolder}/target/debug/egui-demo.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopOnEntry": false,
      "sourceLanguages": ["rust"]
    }
  ]
}
